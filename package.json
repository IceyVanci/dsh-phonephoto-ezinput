{
  "name": "dsh-phonephoto-ezinput",
  "version": "0.1.0",
  "description": "手机扫码拍照，直接把图片投递到 DeepSeek Harness 的指定对话（无需安装 App）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "phone",
    "camera",
    "qrcode",
    "attachment"
  ],
  "engines": {
    "node": ">=20"
  }
}
